<!--
Vertical (portrait) layout - shared by every <aspectRatio name="*_vertical"> block.
Layout is confined to the top area of the screen so a phone controller that
covers the lower part of the display (e.g. GameSir Pocket Taco) does not hide
the UI. Originally calibrated on a 1080x2340 (19.5:9) screen.

All positions come from the <pocket-*> variables in
_inc/vertical/vertical-variables.xml - tune them there.
-->
<theme>

   <!--
   ///
   Gamelist View: Default (textlist)
   ///
   -->

   <fontSize name="small">
      <variables>
         <gamelistBackgroundImageCalculated>./_inc/images/${gamelistBackgroundImage}-small.svg</gamelistBackgroundImageCalculated>
            <gamelistFontSize>0.026</gamelistFontSize>
            <gamelistSelectorHeight>0.018</gamelistSelectorHeight>
         <gamelistLineSpacing>1.7</gamelistLineSpacing>
         <gamelistPos>0.02 ${pocket-gamelist-y}</gamelistPos>
         <gamelistPosFlipped>0.02 ${pocket-gamelist-y}</gamelistPosFlipped>
         <itemsBeforeCenter>4</itemsBeforeCenter>
         <itemsAfterCenter>4</itemsAfterCenter>
         <itemSize>0.26 0.2</itemSize>
      </variables>
   </fontSize>
   <fontSize name="medium">
      <variables>
         <gamelistBackgroundImageCalculated>./_inc/images/${gamelistBackgroundImage}-medium.svg</gamelistBackgroundImageCalculated>
         <gamelistFontSize>0.034</gamelistFontSize>
         <gamelistSelectorHeight>0.0235</gamelistSelectorHeight>
         <gamelistLineSpacing>1.6</gamelistLineSpacing>
         <gamelistPos>0.02 ${pocket-gamelist-y}</gamelistPos>
         <gamelistPosFlipped>0.02 ${pocket-gamelist-y}</gamelistPosFlipped>
         <itemsBeforeCenter>3.5</itemsBeforeCenter>
         <itemsAfterCenter>3.5</itemsAfterCenter>
         <itemSize>0.28 0.22</itemSize>
      </variables>
   </fontSize>
   <fontSize name="large,x-large">
      <variables>
         <gamelistBackgroundImageCalculated>./_inc/images/${gamelistBackgroundImage}-large.svg</gamelistBackgroundImageCalculated>
         <gamelistFontSize>0.041</gamelistFontSize>
         <gamelistSelectorHeight>0.0285</gamelistSelectorHeight>
         <gamelistLineSpacing>1.55</gamelistLineSpacing>
         <gamelistPos>0.02 ${pocket-gamelist-y}</gamelistPos>
         <gamelistPosFlipped>0.02 ${pocket-gamelist-y}</gamelistPosFlipped>
         <itemsBeforeCenter>3</itemsBeforeCenter>
         <itemsAfterCenter>3</itemsAfterCenter>
         <itemSize>0.28 0.22</itemSize>
      </variables>
   </fontSize>

   <!--
   ///
   Gamelist View: Textlist
   ///
   -->

   <variant name="grid-textlist,grid-textlist-flipped,carousel-textlist,carousel-textlist-flipped">
      <view name="gamelist">
         <textlist name="game-list">
            <size>0.96 ${pocket-list-h}</size>
            <fontSize>${gamelistFontSize}</fontSize>
            <selectorHeight>${gamelistSelectorHeight}</selectorHeight>
            <selectorWidth>0.962</selectorWidth>
            <selectorHorizontalOffset>0</selectorHorizontalOffset>
            <lineSpacing>${gamelistLineSpacing}</lineSpacing>
         </textlist>
         <!-- The landscape list panel is portrait shaped; hide it in portrait. -->
         <image name="game-list-background-shadow,game-list-background">
            <origin>0.5 0.5</origin>
            <visible>false</visible>
         </image>
      </view>
   </variant>

   <variant name="grid-textlist,carousel-textlist">
      <view name="gamelist">
         <textlist name="game-list">
            <pos>${gamelistPos}</pos>
         </textlist>
      </view>
   </variant>

   <variant name="grid-textlist-flipped,carousel-textlist-flipped">
      <view name="gamelist">
         <textlist name="game-list">
            <pos>${gamelistPosFlipped}</pos>
         </textlist>
      </view>
   </variant>

   <!--
   ///
   Gamelist View: Media, Badges and Metadata (shared sizes / visibility)
   ///
   -->

   <variant name="grid-textlist,grid-textlist-flipped,grid-carousel,grid-grid-detailed,grid-grid-detailed-flipped,carousel-textlist,carousel-textlist-flipped,carousel-carousel,carousel-grid-detailed,carousel-grid-detailed-flipped">
      <view name="gamelist">
         <!-- Only the game preview and the title are shown in the top area. -->
         <badges name="badges">
            <visible>false</visible>
         </badges>
         <image name="system-logo">
            <visible>false</visible>
         </image>
         <video name="game-media">
            <maxSize>${imagemaxSize}</maxSize>
         </video>
         <!-- Start: Extended Metadata (hidden in portrait) -->
         <image name="game-metadata-background-shadow-extended">
            <size>0.4719652283 0</size>
            <visible>false</visible>
            <zIndex>3</zIndex>
         </image>
         <image name="game-metadata-background-image-extended">
            <size>0.45 0</size>
            <visible>false</visible>
            <zIndex>4</zIndex>
         </image>
         <text name="game-name-extended,game-players-extended,game-genre-extended,game-developer-extended,game-publisher-extended,game-playtime-extended">
            <visible>false</visible>
            <fontSize>${metaDatafontSize}</fontSize>
         </text>
         <datetime name="game-releasedate-extended,game-lastplayed-extended">
            <visible>false</visible>
            <fontSize>${metaDatafontSize}</fontSize>
         </datetime>
         <rating name="game-rating-extended">
            <visible>false</visible>
         </rating>
         <!-- End: Extended Metadata -->
         <!-- Start: Base Metadata (only the game name is shown) -->
         <image name="game-metadata-background-shadow-base">
            <visible>false</visible>
         </image>
         <image name="game-metadata-background-image-base">
            <visible>false</visible>
         </image>
         <text name="game-name-base">
            <size>0.96 ${metaDatafontSize}</size>
            <origin>0.5 0.5</origin>
            <horizontalAlignment>center</horizontalAlignment>
            <visible>true</visible>
            <lineSpacing>1.2</lineSpacing>
            <fontSize>${metaDatafontSize}</fontSize>
         </text>
         <rating name="game-rating-base">
            <visible>false</visible>
         </rating>
         <datetime name="game-releasedate-base">
            <visible>false</visible>
         </datetime>
         <text name="game-genre-base">
            <visible>false</visible>
         </text>
         <!-- End: Base Metadata -->
         <text name="game-description">
            <visible>false</visible>
         </text>
      </view>
      <fontSize name="small">
         <variables>
            <metaDatafontSize>0.028</metaDatafontSize>
            <descriptionPos>0.42</descriptionPos>
            <descriptionHeight>0.1</descriptionHeight>
            <descriptionFontSize>0.028</descriptionFontSize>
            <descriptionLineSpacing>1.2</descriptionLineSpacing>
            <badgepos>0.028 0.44</badgepos>
            <badgeposFlipped>0.528 0.44</badgeposFlipped>
            <badgesize>0.3 0.14</badgesize>
         </variables>
      </fontSize>
      <fontSize name="medium">
         <variables>
            <metaDatafontSize>0.031</metaDatafontSize>
            <descriptionPos>0.42</descriptionPos>
            <descriptionHeight>0.1</descriptionHeight>
            <descriptionFontSize>0.031</descriptionFontSize>
            <descriptionLineSpacing>1.3</descriptionLineSpacing>
            <badgepos>0.028 0.44</badgepos>
            <badgeposFlipped>0.528 0.44</badgeposFlipped>
            <badgesize>0.3 0.14</badgesize>
         </variables>
      </fontSize>
      <fontSize name="large">
         <variables>
            <metaDatafontSize>0.036</metaDatafontSize>
            <descriptionPos>0.42</descriptionPos>
            <descriptionHeight>0.1</descriptionHeight>
            <descriptionFontSize>0.036</descriptionFontSize>
            <descriptionLineSpacing>1.3</descriptionLineSpacing>
            <badgepos>0.028 0.44</badgepos>
            <badgeposFlipped>0.528 0.44</badgeposFlipped>
            <badgesize>0.3 0.16</badgesize>
         </variables>
      </fontSize>
      <fontSize name="x-large">
         <variables>
            <metaDatafontSize>0.040</metaDatafontSize>
            <descriptionPos>0.42</descriptionPos>
            <descriptionHeight>0.1</descriptionHeight>
            <descriptionFontSize>0.040</descriptionFontSize>
            <descriptionLineSpacing>1.3</descriptionLineSpacing>
            <badgepos>0.028 0.44</badgepos>
            <badgeposFlipped>0.528 0.44</badgeposFlipped>
            <badgesize>0.3 0.18</badgesize>
         </variables>
      </fontSize>
      <fontSize name="small,medium">
         <variables>
            <imagepos>0.5 ${pocket-image-y}</imagepos>
            <imageposFlipped>0.5 ${pocket-image-y}</imageposFlipped>
            <imagemaxSize>0.86 0.22</imagemaxSize>
            <logoPos>0.89</logoPos>
         </variables>
      </fontSize>
      <fontSize name="large">
         <variables>
            <imagepos>0.5 ${pocket-image-y}</imagepos>
            <imageposFlipped>0.5 ${pocket-image-y}</imageposFlipped>
            <imagemaxSize>0.86 0.24</imagemaxSize>
            <logoPos>0.89</logoPos>
         </variables>
      </fontSize>
      <fontSize name="x-large">
         <variables>
            <imagepos>0.5 ${pocket-image-y}</imagepos>
            <imageposFlipped>0.5 ${pocket-image-y}</imageposFlipped>
            <imagemaxSize>0.84 0.26</imagemaxSize>
            <logoPos>0.88</logoPos>
         </variables>
      </fontSize>
   </variant>

   <!--
   ///
   Gamelist View: Media / Title positions
   ///
   -->

   <variant name="grid-textlist,grid-carousel,grid-grid-detailed,carousel-textlist,carousel-carousel,carousel-grid-detailed">
      <view name="gamelist">
         <video name="game-media">
            <pos>${imagepos}</pos>
         </video>
         <text name="game-name-base">
            <pos>0.5 ${pocket-name-y}</pos>
         </text>
      </view>
   </variant>

   <variant name="grid-textlist-flipped,grid-grid-detailed-flipped,carousel-textlist-flipped,carousel-grid-detailed-flipped">
      <view name="gamelist">
         <video name="game-media">
            <pos>${imageposFlipped}</pos>
         </video>
         <text name="game-name-base">
            <pos>0.5 ${pocket-name-y}</pos>
         </text>
      </view>
   </variant>

   <!--
   ///
   System View: center the grid inside the top area
   ///
   -->

   <variant name="grid-textlist,grid-textlist-flipped,grid-carousel,grid-boxart-carousel,grid-row,grid-grid-basic,grid-grid-detailed,grid-grid-detailed-flipped">
      <view name="system">
         <grid name="grid">
            <origin>0.5 0.5</origin>
            <pos>0.5 ${pocket-system-y}</pos>
            <size>0.98 ${pocket-system-h}</size>
         </grid>
      </view>
   </variant>

   <!--
   ///
   System View: raise the carousel into the top area
   ///
   -->

   <variant name="carousel-textlist,carousel-textlist-flipped,carousel-carousel,carousel-boxart-carousel,carousel-grid-basic,carousel-grid-detailed,carousel-grid-detailed-flipped,carousel-row">
      <view name="system">
         <carousel name="system-carousel">
            <origin>0 0.5</origin>
            <pos>0 ${pocket-system-y}</pos>
         </carousel>
      </view>
   </variant>

   <!--
   ///
   Clock and status: pushed down to clear the notch and screen edge
   ///
   -->

   <view name="system,gamelist">
      <clock name="clock">
         <pos>0.016 0.05</pos>
      </clock>
      <systemstatus name="systemstatus">
         <pos>0.984 0.05</pos>
      </systemstatus>
      <helpsystem name="help">
         <entrySpacing>0.010</entrySpacing>
         <iconTextSpacing>0.005</iconTextSpacing>
      </helpsystem>
   </view>

</theme>
